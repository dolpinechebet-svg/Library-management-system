# Copy to .env and replace with your hosted PostgreSQL connection URL.
# Never commit .env or share this URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
# Optional: set before seeding to create a login-capable librarian account.
SEED_LIBRARIAN_PASSWORD=""
