{
  "info": {
    "_postman_id": "b20a217c-83ee-4aa3-8885-3d71a4f148ba",
    "name": "Library Management API",
    "description": "Catalog CRUD and authentication endpoints. Register or log in, then use the returned accessToken for protected requests. Book writes require a librarian account.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "genreId", "value": "1" },
    { "key": "bookId", "value": "1" }
  ],
  "item": [
    {
      "name": "Genres",
      "item": [
        {
          "name": "Create genre",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"Mystery\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "List genres",
          "request": { "method": "GET", "url": "{{baseUrl}}/genres" }
        },
        {
          "name": "Get genre",
          "request": { "method": "GET", "url": "{{baseUrl}}/genres/{{genreId}}" }
        },
        {
          "name": "Update genre",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"Mystery & Crime\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/genres/{{genreId}}"
          }
        },
        {
          "name": "Delete genre",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/genres/{{genreId}}" }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "List books (filter, search, paginate)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?genreId={{genreId}}&search=earth&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "genreId", "value": "{{genreId}}" },
                { "key": "search", "value": "earth" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get book",
          "request": { "method": "GET", "url": "{{baseUrl}}/books/{{bookId}}" }
        },
        {
          "name": "Create book (librarian)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"title\":\"The Example\",\"author\":\"A. Writer\",\"isbn\":\"9780306406157\",\"totalCopies\":3,\"genreId\":{{genreId}}}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/books"
          }
        },
        {
          "name": "Update book (librarian)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"totalCopies\":5}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        },
        {
          "name": "Delete book (librarian)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "DELETE",
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        }
      ]
    },
    {
      "name": "Authentication and profile",
      "item": [
        {
          "name": "Register patron",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["if (pm.response.code === 201) {", "  pm.collectionVariables.set('token', pm.response.json().accessToken);", "}"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"Example Patron\",\"email\":\"patron@example.com\",\"password\":\"ChangeThis123!\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["if (pm.response.code === 201 || pm.response.code === 200) {", "  pm.collectionVariables.set('token', pm.response.json().accessToken);", "}"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"patron@example.com\",\"password\":\"ChangeThis123!\"}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Get authenticated profile",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/users/profile"
          }
        }
      ]
    }
  ]
}
